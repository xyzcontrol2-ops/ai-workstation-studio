{
  "name": "ayra-command-center",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host localhost --port 3030 --strictPort",
    "dev:backend": "vite dev --host localhost --port 4040 --strictPort",
    "build": "vite build && tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-loader ./scripts/node-test-resolver.mjs --test --test-timeout=30000",
    "preview": "vite preview --host localhost --port 3030 --strictPort",
    "start": "node --env-file=.env scripts/start-backend.mjs",
    "check": "vite build && tsc --noEmit",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed:departments": "node --env-file=.env --experimental-strip-types scripts/seed-departments.ts",
    "db:seed:agent-roles": "node --env-file=.env --experimental-strip-types scripts/seed-agent-role-taxonomy.ts",
    "worker": "tsx src/orchestrator/agent-worker.ts",
    "worker:dev": "tsx watch src/orchestrator/agent-worker.ts",
    "verify:ollama": "node --experimental-strip-types scripts/verify-ollama.ts",
    "catalog:report": "node --experimental-strip-types scripts/generate-agent-factory-report.mjs"
  },
  "dependencies": {
    "@langchain/core": "^1.0.0",
    "@langchain/langgraph": "^1.0.0",
    "@langchain/openai": "^1.0.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/client": "6.19.3",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "lucide-react": "^1.79.0",
    "monaco-editor": "^0.58.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.187.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@types/node": "^22.5.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.0.1",
    "nitro": "^3.0.260903-beta",
    "prisma": "6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.0.14"
  }
}
