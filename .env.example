# Keep secrets out of source control. The API refuses requests until this is configured.
AYRA_API_TOKEN=

# Separate credential for plan approval decisions.
AYRA_OWNER_TOKEN=

# Optional User IDs for security audit attribution. These must reference existing database users.
AYRA_API_ACTOR_ID=
AYRA_OWNER_ACTOR_ID=

# Keep this 32-byte key private and stable; changing it makes stored provider credentials unreadable.
AYRA_CREDENTIAL_VAULT_KEY=

# OpenAI-compatible model settings. Set the base URL for LiteLLM or a local provider.
AYRA_MODEL_NAME=
AYRA_MODEL_API_KEY=
AYRA_MODEL_BASE_URL=

# Optional, owner-configured root for project workspaces.
AYRA_PROJECT_WORKSPACES_ROOT=

# Optional JSON readiness-factor weights.
AYRA_READINESS_WEIGHTS=

DATABASE_URL=
OLLAMA_BASE_URL=http://localhost:11434
OPENHANDS_API_URL=
OPENHANDS_API_KEY=
AYRA_SECRET_KEY=
